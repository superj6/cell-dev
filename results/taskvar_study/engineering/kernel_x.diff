+static inline double flick(const Ctx *c, int b, double t) {  // prototype: square-wave luminance factor
+  const double h = c->fl_half[b];
+  if (h == 0.0) return 1.0;
+  return fmod(floor((t - c->t0) / h), 2.0) == 1.0 ? c->fl_low[b] : 1.0;
+}
+static void ep_apply(Ctx *c, double t, int reanchor) {  // prototype: the effective world of state ep_s
+  const int B = c->ep_s;
+  c->g_eff = B ? c->g_n * c->ep_motor : c->g_n;
+  c->amp_eff[0] = B ? c->ep_amp0 : 1.0;
+  c->amp_eff[1] = B ? c->b2_amp * c->ep_amp1 : c->b2_amp;
+  c->bg_eff = B ? c->lam_bg * c->ep_bg : c->lam_bg;
+  c->swap_eff = B ? c->ep_swap : 0;
+  const double vt = B ? c->v_t * c->ep_vt : c->v_t;
+  if (vt != c->vt_eff) {
+    c->vt_eff = vt;
+    if (reanchor)
+      for (int b = 0; b < 2; b++) {
+        Blob *Bl = &c->blob[b];
+        if (!Bl->exists) continue;
+        double x, y;
+        blob_at(Bl, t, &x, &y);
+        Bl->x = x; Bl->y = y; Bl->t = t;
+        blob_heading(c->seed, (uint64_t)b, Bl->h - 1, vt, &Bl->vx, &Bl->vy);
+      }
+  }
+}
+static void ep_switch(Ctx *c) {  // prototype: a world event at ep_next
+  const double t = c->ep_next;
+  c->ep_s ^= 1;
+  ep_apply(c, t, 1);
+  const uint64_t w[3] = {14, dbits(t), (uint64_t)c->ep_s};
+  fold(c, H_WORLD, w, 3); fold(c, H_ALL, w, 3);
+  c->ep_next = poisson_next(c->seed, S_EPOCH, 1, c->ep_k, t, c->ep_s ? c->ep_tb : c->ep_ta);
+  c->ep_k += 1;
