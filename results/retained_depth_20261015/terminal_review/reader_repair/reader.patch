+def verify_reader_repair(base):
+    """Bind this separate reader to the reviewed original attempt and explicit PPID repair receipt."""
+    receipt_path = Path(__file__).with_name("reader_repair_receipt.json")
+    repair = read(receipt_path)
+    if (repair.get("kind") != "AO_terminal_monitor_reparenting_only"
+            or repair.get("corrected_reader_name") != Path(__file__).name
+            or repair.get("corrected_reader_sha256") != sha(Path(__file__))
+            or repair.get("original_analyzer_sha256") != sha(base / "analyze.py")):
+        raise ValueError("separate terminal-reader repair provenance differs")
+    for name, digest in repair["input_pins"].items():
+        if sha(local(base, name)) != digest:
+            raise ValueError("terminal-reader repair input changed: " + name)
+    for name, digest in repair["evidence_pins"].items():
+        if sha(local(receipt_path.parent, name)) != digest:
+            raise ValueError("terminal-reader repair evidence changed: " + name)
+    return repair
+
