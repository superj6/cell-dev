+def audit_midpoint(study, folder, protocol, cfg, identity, layout, initial,
+                   lines, curves, selected, operations, replay, spec):
+    """Replay the prescribed generation4 population against the uninterrupted final log prefix."""
+    middle = folder / 'generation4'
+    saved = torch.load(middle / 'checkpoint.pt', map_location='cpu', weights_only=True)
+    selected.equal(saved['format'], 1, 'midpoint checkpoint format')
+    selected.equal(saved['config'], cfg, 'midpoint eight-generation target configuration')
+    selected.equal(saved['identity'], identity, 'midpoint extended identity')
+    state = saved['state']
+    for key, value in {'generation': 4, 'evals': 1024, 'rc_lives': 2048}.items():
+        selected.equal(state[key], value, 'midpoint checkpoint ' + key)
+    selected.equal(state['curves'], curves[:4], 'midpoint curve prefix')
+    selected.equal(set(saved['logs']), {'curves.jsonl', 'lineage.jsonl', 'clones.jsonl'},
+                   'midpoint log coverage')
+    prefixes = {}
+    for name, metadata in saved['logs'].items():
+        size = metadata['bytes']
+        if type(size) is not int or size < 0:
+            raise ValueError('invalid midpoint log prefix length')
+        with (folder / name).open('rb') as stream:
+            data = stream.read(size)
+        selected.equal(len(data), size, 'midpoint log prefix length')
+        selected.equal(hashlib.sha256(data).hexdigest(), metadata['sha256'], 'midpoint log prefix hash')
+        prefixes[name] = [json.loads(line) for line in data.splitlines() if line.strip()]
+    selected.equal(prefixes['curves.jsonl'], curves[:4], 'exact midpoint curve records')
+    selected.equal(prefixes['lineage.jsonl'], lines[:5], 'exact midpoint lineage records')
+    selected.equal(prefixes['clones.jsonl'], [], 'disabled midpoint clone lives')
+    view_lines, view_curves = copy.deepcopy(lines[:5]), copy.deepcopy(curves[:4])
+    for row in [*view_lines[1:], *view_curves]:
+        if 'T' in row:
+            selected.equal(row['T'], 1024, 'midpoint optional duration')
+        row['T'] = 1024
+    selection = selected.audit_lineage(view_lines, view_curves, state, protocol['native_seed'], spec)
+    genetics = operations.replay_genetics(lines[:5], state, layout, initial[0], False,
+                                         initial_population=initial)
+    _, best = type(layout).load(middle / 'best_genome.json')
+    if not operations.same(best.numpy(), state['population'][0].numpy()):
+        raise ValueError('midpoint endpoint is not reconstructed rank zero')
+    snapshot = read(middle / 'snapshot.json')
+    expected = {'status': 'complete', 'generation': 4, 'rank': 0,
+        'rank_zero_id': int(state['ids'][0]), 'checkpoint_sha256': sha(middle / 'checkpoint.pt'),
+        'genome_file_sha256': sha(middle / 'best_genome.json'),
+        'genome_raw_sha256': replay.raw_sha(best.numpy()),
+        'population_raw_sha256': replay.raw_sha(state['population'].numpy()),
+        'identity': identity, 'log_prefix_pins': saved['logs'],
+        'protocol_sha256': sha(study / 'protocol.json'), 'release_sha256': sha(study / 'release.json'),
+        'added_lives': 0, 'random_draws': 0}
+    selected.equal(snapshot, expected, 'complete passive midpoint snapshot')
+    selected.equal(read(folder / 'search_complete.json')['midpoint'], snapshot,
+                   'completed search midpoint binding')
+    return {'status': 'passed', 'generation': 4, 'checkpoint_sha256': sha(middle / 'checkpoint.pt'),
+        'snapshot_sha256': sha(middle / 'snapshot.json'), 'selection': selection,
